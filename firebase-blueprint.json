{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A project item with subtasks and deadlines",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "deadline": { "type": "string" },
        "priorityLevel": { "type": "string" }
      },
      "required": ["id", "name", "status"]
    },
    "Routine": {
      "title": "Routine",
      "description": "A recurring routine item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "scheduleType": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "Habit": {
      "title": "Habit",
      "description": "A habit tracking item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "DatabaseDump": {
      "title": "DatabaseDump",
      "description": "Full application data sync payload",
      "type": "object",
      "properties": {
        "version": { "type": "number" },
        "exportedAt": { "type": "string" }
      },
      "required": ["version"]
    },
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Per-user private productivity workspace data",
      "type": "object",
      "properties": {
        "version": { "type": "number" },
        "exportedAt": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string" }
      },
      "required": ["version"]
    }
  },
  "firestore": {
    "/users/{userId}/workspace/{docId}": {
      "schema": "UserWorkspace",
      "description": "Per-user private workspace document holding routines, habits, projects, learning, and reminders"
    },
    "/workspace/{docId}": {
      "schema": "DatabaseDump",
      "description": "Workspace data document containing projects, routines, habits, learning, phases, seasons, and notes"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Individual project document"
    },
    "/routines/{routineId}": {
      "schema": "Routine",
      "description": "Individual routine document"
    },
    "/habits/{habitId}": {
      "schema": "Habit",
      "description": "Individual habit document"
    }
  }
}
